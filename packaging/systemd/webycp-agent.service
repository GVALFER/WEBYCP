[Unit]
Description=WEBYCP privileged host agent
Documentation=https://github.com/GVALFER/WEBYCP
Wants=network-online.target
After=network-online.target
Before=webycp-server.service

[Service]
Type=simple
User=root
Group=webycp
EnvironmentFile=/etc/webycp/agent.env
ExecStart=/usr/lib/webycp/webycp-agent
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
UMask=0022

RuntimeDirectory=webycp
RuntimeDirectoryMode=0750

NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
RestrictRealtime=true
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
